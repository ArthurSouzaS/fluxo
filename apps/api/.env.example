# Ambiente: development | test | production
NODE_ENV=development
PORT=3333
# Conexão com o PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fluxo?schema=public
# Segredos dos tokens (troque em produção! Use valores longos e aleatórios)
JWT_ACCESS_SECRET=troque-este-segredo-de-acesso-com-pelo-menos-32-caracteres
JWT_REFRESH_SECRET=troque-este-segredo-de-refresh-com-pelo-menos-32-caracteres
# Duração do access token (ex.: 15m) e do refresh token em dias
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=7
# Origens permitidas no CORS (separadas por vírgula)
CORS_ORIGIN=http://localhost:3000
# Pasta onde os anexos são salvos e tamanho máximo (MB)
UPLOAD_DIR=./uploads
UPLOAD_MAX_MB=10
# true quando a API estiver atrás de HTTPS (cookies Secure)
COOKIE_SECURE=false
